# ============================================================
# Sell Up Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit real secrets.
# ============================================================

# --- Application ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:3000

# --- Subdomain architecture ---
# Apex domain that serves public business pages:  https://{business_slug}
# Marketing lives on try.<base> and the merchant app lives on app.<base>.
# Set NEXT_PUBLIC_APP_URL to https://app.<base> in production so auth emails
# and payment callbacks land on the app subdomain.
NEXT_PUBLIC_BASE_DOMAIN=sellup.ng

# --- Supabase (PostgreSQL + Auth + Storage) ---
# Find these in your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (SERVER-ONLY, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- JWT (used for app-level session signing where needed) ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Database (Supabase Postgres direct connection / pooler) ---
# Use the Supabase "Session pooler" or "Transaction pooler" connection string.
# Format:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Or the direct connection:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.supabase.com:5432/postgres
DATABASE_URL=

# --- Payments (Phase: Billing) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# --- Storage (Object storage for product/store images) ---
# Supabase Storage can be used directly via the JS client.
# For S3-compatible storage, configure:
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@sellup.ng
RESEND_FROM_NAME=Sell Up

# --- Cron-triggered background jobs ---
CRON_SECRET=
# POST /api/cron/announcement-deliveries on a frequent schedule with
# x-cron-secret: $CRON_SECRET; each request processes bounded batches.
# POST /api/cron/subscription-dunning hourly with the same header.

# --- WhatsApp ---
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=

# --- AI provider endpoint allowlist ---
# Comma-separated exact HTTPS hostnames for custom OpenAI-compatible providers.
# Built-in hosts include api.openai.com, api.anthropic.com, api.mistral.ai,
# api.deepseek.com, api.groq.com, openrouter.ai, and Google's API host.
AI_PROVIDER_ALLOWED_HOSTS=

# --- Cloudflare for SaaS custom-hostname TLS retries ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Database backups ---
BACKUP_DIRECTORY=
BACKUP_DOWNLOAD_SECRET=
BACKUP_RETENTION_DAYS=30
PG_DUMP_PATH=pg_dump

# --- Platform Admin Seeder ---
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
